{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oppostest.example/schemas/bank-v1.json",
  "title": "OpposTest bank schema v1",
  "type": "object",
  "required": ["schema_version", "bank", "topics", "questions"],
  "properties": {
    "schema_version": { "const": 1 },
    "bank": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "generated_at": { "type": "string" },
        "description": { "type": "string" }
      },
      "additionalProperties": true
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "parent_id"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "parent_id": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "statement", "options", "correct_option_id", "topic_ids", "is_annulled"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "statement": { "type": "string", "minLength": 1 },
          "options": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": ["id", "text"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "text": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            }
          },
          "correct_option_id": { "type": "string", "minLength": 1 },
          "topic_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "source": { "type": ["object", "null"] },
          "explanation": { "type": ["string", "null"] },
          "legal_reference": { "type": ["string", "null"] },
          "notes": { "type": ["string", "null"] },
          "is_annulled": { "type": "boolean" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
