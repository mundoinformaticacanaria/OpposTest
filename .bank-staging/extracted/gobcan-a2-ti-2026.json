      "id": "gobcan-a2-tinl26-q001",
      "statement": "Conforme al artículo 9 de la Ley 40/2015, de 1 de octubre, de Régimen Jurídico del Sector Público, los órganos de las diferentes Administraciones Públicas podrán delegar:",
      "options": [
        {
          "id": "A",
          "text": "La adopción de disposiciones de carácter general."
        },
        {
          "id": "B",
          "text": "El ejercicio de las competencias que tengan atribuidas en otros órganos de la misma Administración."
        },
        {
          "id": "C",
          "text": "La resolución de recursos en los órganos administrativos que hayan dictado los actos objeto de recurso."
        },
        {
          "id": "D",
          "text": "Las materias en que así se determine por norma con rango de Ley."
        }
      ],
      "correct_option_id": "B",
