    {
      "id": "gobcan-a2-tinl26-q012",
      "statement": "De acuerdo con el artículo 35 de la Ley 12/2014, de 26 de diciembre, de transparencia y de acceso a la información pública, ¿quiénes son titulares del derecho de acceso a la información pública?",
      "options": [
        {
          "id": "A",
          "text": "Solo las personas físicas que tengan la condición de interesadas en un procedimiento administrativo."
        },
        {
          "id": "B",
          "text": "Solo las personas empadronadas en algún municipio de la Comunidad Autónoma de Canarias."
        },
        {
          "id": "C",
          "text": "Todas las personas, en los términos previstos en esta ley y en el resto del ordenamiento jurídico."
        },
        {
          "id": "D",
          "text": "Únicamente las personas jurídicas que acrediten un interés legítimo."
        }
      ],
      "correct_option_id": "C",
