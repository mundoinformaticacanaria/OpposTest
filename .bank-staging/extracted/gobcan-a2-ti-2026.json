    {
      "id": "gobcan-a2-tinl26-q013",
      "statement": "El principio de minimización de datos, contemplado en el artículo 5.1 del Reglamento (UE) 2016/679, de 27 de abril de 2016, relativo a la protección de las personas físicas, exige que los datos personales sean:",
      "options": [
        {
          "id": "A",
          "text": "Almacenados de forma indefinida para garantizar la trazabilidad."
        },
        {
          "id": "B",
          "text": "Adecuados, pertinentes y limitados a lo necesario en relación con los fines para los que son tratados."
        },
        {
          "id": "C",
          "text": "Comunicados a todas las autoridades públicas que los soliciten."
        },
        {
          "id": "D",
          "text": "Recogidos en la mayor cantidad posible para permitir análisis estadísticos futuros."
        }
